# Copy to .env and fill in. Never commit .env.

# Shopify (Dev Dashboard app): Client ID + Client Secret from the app's Settings page
SHOPIFY_CLIENT_ID_MY_SHOPIFY_STORE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET_MY_SHOPIFY_STORE=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ...or, for a legacy custom app created before 2026, an Admin API token instead:
# SHOPIFY_TOKEN_MY_SHOPIFY_STORE=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WooCommerce: REST API consumer key / secret (WooCommerce -> Settings -> Advanced -> REST API)
WOO_KEY_MY_WOO_STORE=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_SECRET_MY_WOO_STORE=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/analytics
# SYNC_INTERVAL_MINUTES=60      # re-sync all stores in the background every hour
# AUTO_SEED=1                   # load demo data when no store is connected (default 1)
